---
// In-page tabs for the current menu group (e.g. Papers | Patents). Built from NAV, so every page in a group shows the same tabs.
import { NAV } from '../lib/nav';
import { href } from '../lib/img';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const current = Astro.url.pathname.replace(base, '').replace(/\/$/, '') || '/';
const tabs = NAV.find((i) => i.children?.some((c) => c.href === current))?.children ?? [];
---
{tabs.length > 1 && (
  <nav class="subtabs" aria-label="Section">
    {tabs.map((t) => <a href={href(t.href)} aria-current={t.href === current ? 'page' : undefined}>{t.label}</a>)}
  </nav>
)}
