---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import home from '../data/home.yaml';
import { img } from '../lib/img';
interface Props { title?: string; description?: string; wide?: boolean }
const { title, description = 'ECME LAB — Prof. Ju-Hyuck Lee\'s Research Group, DGIST. Energy Conversion Materials Engineering.' } = Astro.props;
const full = title ? `${title} | JU HYUCK LEE's Group` : "Home | JU HYUCK LEE's Group";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={img(home.logo)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700&family=Work+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
    <slot name="head" />
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
  </body>
</html>
