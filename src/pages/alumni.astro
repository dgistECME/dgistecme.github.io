---
import Base from '../layouts/Base.astro';
import a from '../data/alumni.yaml';
---
<Base title="Alumni">
  <main class="wrap">
    <h1 class="section-title">Alumni</h1>
    <ul class="plain">
      {a.graduates.map((g: any) => (
        <li>
          {g.raw ?? <>{g.name_ko} ({g.name_en}, {g.degree} {g.graduated}){g.affiliation && <span class="aff"> — {g.affiliation}</span>}</>}
        </li>
      ))}
    </ul>

    <h2 class="section-title">Undergraduate Research Program (UGRP) Team</h2>
    <ul class="plain">
      {a.ugrp.map((u: any) => <li><b>{u.year}</b> &nbsp; {u.names.join(', ')}</li>)}
    </ul>

    <h2 class="section-title">Undergraduate Intern</h2>
    <ul class="plain">
      {a.interns.map((u: any) => <li><b>{u.year} {u.season} Internship</b> : {u.names.join(', ')}</li>)}
    </ul>
  </main>
</Base>
