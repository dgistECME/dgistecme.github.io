---
import Base from '../layouts/Base.astro';
import SubTabs from '../components/SubTabs.astro';
import press from '../data/press.yaml';
import { img } from '../lib/img';
const tabs = [{ label: 'ARTICLES', href: '/articles' }, { label: 'PHOTOS', href: '/photos' }];
const years = [...new Set(press.map((a: any) => a.year))].sort((a: any, b: any) => b - a);
---
<Base title="Articles">
  <main class="wrap" style="max-width:820px">
    <SubTabs tabs={tabs} current="/articles" />
    {years.map((y) => (
      <section>
        <h2 class="year">{y}</h2>
        {press.filter((a: any) => a.year === y).map((a: any) => (
          <article class="press">
            {a.thumbnail ? <a href={a.url} target="_blank" rel="noopener"><img src={img(a.thumbnail, 'thumb')} alt="" loading="lazy" /></a> : <div />}
            <div>
              <h3>{a.url ? <a href={a.url} target="_blank" rel="noopener">{a.title}</a> : a.title}</h3>
              {a.summary && <p>{a.summary}</p>}
              <div class="meta">{a.date}<b>{a.outlet}</b></div>
            </div>
          </article>
        ))}
      </section>
    ))}
  </main>
</Base>
