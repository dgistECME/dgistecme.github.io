---
import Base from '../layouts/Base.astro';
import home from '../data/home.yaml';
import news from '../data/news.yaml';
import research from '../data/research.yaml';
import { img, href } from '../lib/img';
const latest = news.slice(0, 4);
---
<Base>
  <Fragment slot="hero">
    <section class="hero">
      <img class="bg" src={img(home.banner)} alt="ECME LAB members" fetchpriority="high" />
      <div class="copy wrap">
        <div class="eyebrow" style="color:var(--c-accent)">ECME LAB · DGIST 에너지공학과 이주혁 교수 연구실</div>
        <h1>Energy Conversion Materials Engineering</h1>
        <div class="row">
          <p class="lead">Prof. Ju-Hyuck Lee's Research Group, DGIST. Harvesting waste mechanical energy with piezoelectric and triboelectric nanogenerators — toward battery-free, self-powered electronics.</p>
          <div class="btns">
            <a class="btn primary" href={href('/research')}>Research</a>
            <a class="btn ghost" href={href('/opening')}>Join</a>
          </div>
        </div>
      </div>
    </section>
    <section class="wrap">
      <div class="strip">
        {latest.map((n: any) => <div><span class="d">{n.date}</span><span>{n.text}</span></div>)}
      </div>
    </section>
  </Fragment>

  <main class="wrap home-light">
    <div class="split">
      <div class="l">
        <div class="eyebrow">ECME Lab</div>
        <h2>Knowledge for the welfare of mankind.</h2>
        <p class="mission">{home.mission}</p>
      </div>
      <div class="r">
        <div class="eyebrow">Research</div>
        <div class="cells" style="margin-top:.6rem">
          {research.topics.map((t: any, i: number) => (
            <a href={href('/research')}>
              <span class="n">{String(i + 1).padStart(2, '0')}</span>
              <span class="t">{t.title}</span>
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="split" style="margin-top:clamp(3rem,6vw,5rem)">
      <div class="l">
        <div class="eyebrow">In the press</div>
        <h2>Articles</h2>
        <div class="cells one">
          {home.highlights.map((h: any) => (
            <a href={h.url} target="_blank" rel="noopener"><span class="t">{h.title}</span></a>
          ))}
          <a href={href('/articles')}><span class="m">All articles →</span></a>
        </div>
      </div>
      <div class="r">
        <div class="eyebrow">Lab news</div>
        <h2>ECME News</h2>
        <ul class="newslist">
          {news.map((n: any) => <li><span class="d">{n.date}</span><span>{n.text}</span></li>)}
        </ul>
      </div>
    </div>
  </main>
</Base>
